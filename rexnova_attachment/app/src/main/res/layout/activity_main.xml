<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/rx_bg">

    <com.rexai.controller.RexCoreView
        android:id="@+id/rexCore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.30"
        android:contentDescription="Full-screen animated Rex AI background"/>

    <LinearLayout
        android:id="@+id/rexForeground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/rx_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:contentDescription="Rex AI logo"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REX AI"
                android:textColor="#F2F5FF"
                android:textSize="23sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtBrainStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL AI SYSTEM"
                android:textColor="#80CFE8"
                android:textSize="11sp"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/rx_btn2"
            android:text="API"
            android:textAllCaps="false"
            android:textColor="#DDE8FF"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/rx_btn2"
            android:text="⚙"
            android:textAllCaps="false"
            android:textColor="#55D6FF"
            android:textSize="19sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Rex tools and settings"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="YOUR INTELLIGENT ASSISTANT"
        android:textColor="#91A9CC"
        android:textSize="10sp"
        android:letterSpacing="0.13"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/rx_card"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="नमस्कार राजा! मी Rex आहे. आज मी तुम्हाला कशी मदत करू?"
                android:textColor="#E8EEFF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/chipYt" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="▶ YouTube" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipWa" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="💬 WhatsApp" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipCh" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="🌐 Chrome" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipSe" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="⚙ Settings" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipCa" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="📷 Camera" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipMa" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="🗺 Maps" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipIn" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="📸 Insta" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipGm" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="✉ Gmail" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
            <Button android:id="@+id/chipPh" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/rx_btn2" android:text="📞 Phone" android:textColor="#DDE8FF" android:textSize="11sp" android:textAllCaps="false"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/rx_btn2"
            android:text="💬  Chat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnAgent"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/rx_btn2"
            android:text="🤖  Agent"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnLive"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/rx_btn"
            android:text="🎙  Live"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Attachment Preview Container -->
    <LinearLayout
        android:id="@+id/layoutAttachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/rx_card"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgAttachmentPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rx_circle"
            android:clipToOutline="true"
            android:contentDescription="Attachment preview"/>

        <TextView
            android:id="@+id/txtAttachmentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="File attached"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <Button
            android:id="@+id/btnRemoveAttachment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rx_btn2"
            android:text="✕"
            android:textColor="#FF5555"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:contentDescription="Remove attachment"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAttach"
            android:layout_width="44dp"
            android:layout_height="54dp"
            android:background="@drawable/rx_btn2"
            android:text="+"
            android:textColor="#55D6FF"
            android:textSize="24sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Attach image or document"/>

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="54dp"
            android:maxLines="4"
            android:background="@drawable/rx_card"
            android:hint="Rex ला command द्या..."
            android:textColor="#FFFFFF"
            android:textColorHint="#91A9CC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textMultiLine|textCapSentences"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rx_btn"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Send command"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOOLS &amp; CONTROL"
            android:textColor="#80CFE8"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrain"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/rx_btn"
                android:text="🧠 Brain"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnDeveloper"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/rx_btn2"
                android:text="🛠 Developer"
                android:textAllCaps="false"
                android:textColor="#80CFE8"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/rx_btn2"
            android:text="♿ Screen Agent permission (Accessibility)"
            android:textAllCaps="false"
            android:textColor="#80CFE8"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>